# Copy to config/paths.env (git-ignored) and edit. Sourced by the new scripts.
export SAMPLE_ID="PROBAND_ID_FROM_DATASET"
export WORKDIR="/path/to/workdir"                 # large intermediate files live here, never in git
export BAM="$WORKDIR/results/${SAMPLE_ID}.sorted.bam"
export EXOMISER_GENES_TSV="$WORKDIR/results/exomiser_result.genes.tsv"
export OUTDIR="$WORKDIR/results/mosaic_depth"
